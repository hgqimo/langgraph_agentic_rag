# LangGraph Agentic RAG configuration. Copy to .env and adjust.
# Load with:  set -a; source .env; set +a
# All variables are optional; defaults shown below.

# ---------------- LLM backend (OpenAI-compatible, e.g. vLLM) ----------------
RAG_MODEL=Qwen/Qwen2.5-7B-Instruct
RAG_BASE_URL=http://127.0.0.1:8000/v1
RAG_API_KEY=EMPTY
RAG_TEMPERATURE=0.6
RAG_MAX_TOKENS=512
RAG_MAX_RETRIES=3
RAG_RETRY_INTERVAL=1.0
# Qwen3 on vLLM: disable thinking mode via chat_template_kwargs (default true)
RAG_DISABLE_THINKING=1
# Extra JSON merged into every chat request body, e.g. {"top_p": 0.9}
RAG_EXTRA_BODY=

# ---------------- Offline mock (no LLM needed) ----------------
RAG_MOCK=0
RAG_MOCK_ROUTE=qds

# ---------------- Retrieval ----------------
# auto | http | mock | none | llm | vector | engine
RAG_RETRIEVAL_MODE=auto
# Comma-separated search endpoints (overrides RAG_SEARCH_HOST pool of 8 ports)
RAG_SEARCH_URLS=
RAG_SEARCH_HOST=127.0.0.1
RAG_RETRIEVAL_TIMEOUT=5.0
RAG_RETRIEVAL_ATTEMPTS=5
RAG_RETRIEVAL_RAISE=0

# ---------------- Embeddings (vector/engine modes) ----------------
RAG_EMBED_BASE_URL=http://127.0.0.1:10200/v1
RAG_EMBED_MODEL=text-embedding-3-small
RAG_EMBED_API_KEY=EMPTY
RAG_EMBED_BATCH=16
# Local corpus JSONL for vector/engine modes: {"text": ...} per line
RAG_CORPUS=
RAG_TOP_K=5
RAG_CACHE_DIR=.cache

# ---------------- Rerank (optional, model-level cross-encoder) ----------------
# off | single_pass (tournament is Jev-backend only)
RAG_RERANK_MODE=off
# qwen3 = Qwen3-Reranker-4B cross-encoder (default) | jev = NeoHorse-Jev-4B decision model
RAG_RERANK_BACKEND=qwen3
# Empty = backend default endpoint (qwen3 -> :8090, jev -> :8080)
RAG_RERANK_URL=
# Candidates pulled from the engine before reranking down to RAG_TOP_K
RAG_RERANK_POOL=30
RAG_RERANK_MAX_DOC_CHARS=600

# ---------------- Adaptive retrieval loop (INTERACT-RAG style) ----------------
# 1 = single retrieval; >1 enables retrieve -> judge -> rewrite -> re-retrieve
RAG_MAX_ROUNDS=1
RAG_JUDGE_MISSING_WORDS=60

# ---------------- Self-evolving memory (GAM-RAG style, training-free) ----------------
# off | gold (GT attribution, eval only) | agent (self-annotated, production)
RAG_MEMORY_FEEDBACK=off
# SQLite persistence for cross-process evolution; empty = in-memory only
RAG_MEMORY_DB=
# Kalman hyper-parameters (paper Appendix C: asymmetric, negative more conservative)
RAG_MEMORY_R_POS=0.5
RAG_MEMORY_R_NEG=1.0
RAG_MEMORY_Q=0.05
# Persistent exclusion / memory-activation injection thresholds
RAG_MEMORY_EXCLUDE_COS=-0.25
RAG_MEMORY_EXCLUDE_PI=0.35
RAG_MEMORY_INJECT=2
RAG_MEMORY_INJECT_COS=0.65
RAG_MEMORY_INJECT_PI=0.5
# Strategy memory (semantic key -> judge plan warm-start)
RAG_MEMORY_STRATEGIES=1
RAG_MEMORY_STRATEGY_MAX=64
# Warm-start requires >= N independent successes (anti-pollution, see docs/EXPERIMENTS.md §9)
RAG_MEMORY_STRATEGY_MIN_POS=3

# ---------------- Workflow switches ----------------
RAG_ENABLE_QDP=1
RAG_ENABLE_DS=1
RAG_SUB_WORKFLOW_OVERRIDE=R,DS,AG
RAG_INVALID_PENALTY=-2.0
RAG_DEFAULT_WORKFLOW=QDS
RAG_MAX_SUB_QUESTIONS=7
RAG_ALPHA=0.0
RAG_BETA=0.0

# ---------------- Evaluation ----------------
# Dataset root (defaults to <repo>/datasets); layout in datasets/README.md
RAG_DATA_ROOT=
